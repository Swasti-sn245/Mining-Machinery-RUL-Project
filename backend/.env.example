# MineGuard backend — environment configuration
# Copy this file to .env for local development, or set these as real
# environment variables in your deployment platform (Render, Railway, Docker, etc.)

# -- Server --
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO

# -- CORS --
# Comma-separated list of allowed frontend origins. "*" is fine for local dev
# but MUST be restricted before going to production, e.g.:
# ALLOWED_ORIGINS=https://mineguard.vercel.app,https://your-domain.com
ALLOWED_ORIGINS=*

# -- Rate limiting --
# Requests per minute per client IP on POST /predict
RATE_LIMIT_PER_MINUTE=60

# -- Model artifacts --
# Leave blank to auto-resolve to ../model relative to backend/app_v4.py.
# Set explicitly if you mount the model directory elsewhere (e.g. in Docker).
MODEL_DIR=
